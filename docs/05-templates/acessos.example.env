# ============================================================================
# Cofre de Acessos do OML — TEMPLATE (acessos.example.env) — SÓ CHAVES
# ============================================================================
# Copie este arquivo para `acessos.local.env` (na raiz do OML) e preencha os
# VALORES reais LÁ. O `acessos.local.env` é IGNORADO pelo git e NUNCA é
# commitado, versionado, impresso ou copiado para `memoria/`. Este `.example`
# carrega apenas as chaves, para você saber o que preencher.
#
# Para que serve: dar ao OML os acessos operacionais para ELE resolver o
# problema de ponta a ponta — logar no ERP legado/novo, consultar o banco,
# acessar integrações — sem depender de você executar cada passo.
#
# Regras (ver docs/04-protocolos/protocolo-acessos-oml.md e
#          docs/03-guardioes/guardiao-segredos-credenciais.md):
#   - Valores reais vivem SÓ em acessos.local.env (gitignored).
#   - O OML NUNCA imprime/ecoa/loga VALORES nem os copia para a memória.
#   - 2FA/captcha/SSO não se burla: o OML para e pede o passo humano.
#   - Preencha só os blocos que existirem no seu projeto; deixe o resto vazio.
# ----------------------------------------------------------------------------

# --- Sistema LEGADO (login na aplicação web) --------------------------------
LEGADO_URL=
LEGADO_USUARIO=
LEGADO_SENHA=
LEGADO_OBS=            # 2FA? perfil necessário? URL de homologação? captcha?

# --- Sistema NOVO (login na aplicação migrada) ------------------------------
NOVO_URL=
NOVO_USUARIO=
NOVO_SENHA=

# --- Banco de dados LEGADO (somente leitura/consulta) -----------------------
DB_LEGADO_HOST=
DB_LEGADO_PORT=
DB_LEGADO_DATABASE=
DB_LEGADO_USUARIO=
DB_LEGADO_SENHA=

# --- Banco de dados NOVO ----------------------------------------------------
DB_NOVO_HOST=
DB_NOVO_PORT=
DB_NOVO_DATABASE=
DB_NOVO_USUARIO=
DB_NOVO_SENHA=

# --- Integrações / serviços externos (um bloco por serviço) -----------------
# Duplique o par abaixo trocando <SERVICO> pelo nome do serviço (ex.: METABASE).
# API_<SERVICO>_BASE_URL=
# API_<SERVICO>_TOKEN=
